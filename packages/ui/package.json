{
  "name": "@campaign-lens/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./button": "./src/components/button.tsx",
    "./sidebar": "./src/components/sidebar.tsx",
    "./breadcrumb": "./src/components/breadcrumb.tsx",
    "./separator": "./src/components/separator.tsx",
    "./sheet": "./src/components/sheet.tsx",
    "./skeleton": "./src/components/skeleton.tsx",
    "./tooltip": "./src/components/tooltip.tsx",
    "./input": "./src/components/input.tsx",
    "./card": "./src/card.tsx",
    "./code": "./src/code.tsx"
  },
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "latest",
    "@hugeicons/core-free-icons": "latest",
    "@hugeicons/react": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hugeicons-react": "^0.3.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@campaign-lens/eslint-config": "workspace:*",
    "@campaign-lens/typescript-config": "workspace:*",
    "@types/node": "^22.13.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
