{
  "name": "@campaign-lens/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./queries": "./src/queries/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/migrate.ts",
    "db:push": "drizzle-kit push",
    "test": "node --test",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },

  "dependencies": {
    "@campaign-lens/domain": "workspace:*",
    "@neondatabase/serverless": "^0.10.4",
    "drizzle-orm": "^0.39.3"
  },
  "devDependencies": {
    "@campaign-lens/eslint-config": "workspace:*",
    "@campaign-lens/typescript-config": "workspace:*",
    "drizzle-kit": "^0.30.4",
    "typescript": "5.9.2"
  }
}
