# ==============================================================================
# CampaignLens - Environment Variables Example
# ==============================================================================
# Copy this file to .env or reference the app-specific examples below.
#
# Apps & Packages:
# - apps/api: Uses .dev.vars for local Cloudflare Worker development (DATABASE_URL, BRIGHT_DATA_API_TOKEN)
# - apps/web: Uses .env for local TanStack Start development (VITE_API_URL)
# - packages/db: Uses DATABASE_URL for migrations (pnpm run migrate)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL / Neon Serverless)
# ------------------------------------------------------------------------------
# Required by apps/api and packages/db for storing snapshots, events, sources,
# scrape runs, recovery runs, and audit logs.
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/campaign_lens?sslmode=require"

# ------------------------------------------------------------------------------
# 2. Bright Data Scraper Studio
# ------------------------------------------------------------------------------
# Required by apps/api for triggering Scraper Studio browser collectors and
# managing autonomous AI Self-Healing recovery.
# Kept strictly server-side (never exposed to browser clients).
BRIGHT_DATA_API_TOKEN="your_bright_data_api_token_here"

# ------------------------------------------------------------------------------
# 3. Web Frontend API URL
# ------------------------------------------------------------------------------
# Used by apps/web to communicate with the CampaignLens API.
# Local development default: http://localhost:8787
# Production deployment: https://campaign-lens-api.demostore.workers.dev
VITE_API_URL="http://localhost:8787"
